mu = CP.PropsSI('V', 'T', 300, 'P', 1e6, fluido)
cp = CP.PropsSI('Cpmass', 'T', 300, 'P', 1e6, fluido)
k = CP.PropsSI('L', 'T', 300, 'P', 1e6, fluido)
nu = mu / rho
alpha = k / (rho * cp)
v_star, L_max = 0.05, 0.001

print(f"Propriedades do {fluido}:")
