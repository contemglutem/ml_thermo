# Converter constantes para tensores GPU
with tf.device('/GPU:0' if gpus else '/CPU:0'):
    rho_tf = tf.constant(rho, dtype=tf.float32)
    cp_tf = tf.constant(cp, dtype=tf.float32)
    nu_tf = tf.constant(nu, dtype=tf.float32)
    alpha_tf = tf.constant(alpha, dtype=tf.float32)
    v_star_tf = tf.constant(v_star, dtype=tf.float32)
    L_max_tf = tf.constant(L_max, dtype=tf.float32)

# --- 2. GERAR DADOS SINTÉTICOS ---
q_flux_real = 5000.0
T_parede = 320.0

def integrando_analitico(y_val):
    nu_t = nu * ((y_val * v_star) / (14.5 * nu))**3
    return 1 / (alpha + nu_t)

def solucao_analitica(y_array, T_parede, q_flux, rho, cp):
    T_analitica = []
    for y in y_array:
        integral, _ = quad(integrando_analitico, 0, y)
        temp = T_parede - (q_flux / (rho * cp)) * integral
        T_analitica.append(temp)
    return np.array(T_analitica)

n_medicoes = 12
y_medicoes_fisico = np.linspace(0.0001, L_max, n_medicoes)
T_medicoes = solucao_analitica(y_medicoes_fisico, T_parede, q_flux_real, rho, cp)

np.random.seed(42)
ruido = np.random.normal(0, 0.05, n_medicoes)
