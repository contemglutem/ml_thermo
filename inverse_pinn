# --- 6. MONITORAMENTO DE RECURSOS ---
class ResourceMonitor:
    def __init__(self):
        self.cpu_history = []
        self.ram_history = []
        self.gpu_history = []
        self.has_nvidia_smi = self._check_nvidia_smi()
    
    def _check_nvidia_smi(self):
        try:
            import subprocess
            result = subprocess.run(['nvidia-smi'], capture_output=True)
            return result.returncode == 0
        except:
            return False
    
    def get_gpu_usage(self):
        if not self.has_nvidia_smi:
            return None
        try:
            import subprocess
            result = subprocess.run(['nvidia-smi', '--query-gpu=utilization.gpu,memory.used,memory.total', 
                                   '--format=csv,noheader,nounits'], 
                                  capture_output=True, text=True, timeout=1)
            if result.returncode == 0:
                gpu_util, mem_used, mem_total = map(float, result.stdout.strip().split(','))
                return {'util': gpu_util, 'mem_used': mem_used, 'mem_total': mem_total}
        except:
            pass
        return None
    
    def update(self):
        self.cpu_history.append(psutil.cpu_percent(interval=0.1))
        self.ram_history.append(psutil.virtual_memory().percent)
        
        gpu_info = self.get_gpu_usage()
        if gpu_info:
            self.gpu_history.append(gpu_info)
    
    def get_stats(self):
        stats = {
            'cpu': self.cpu_history[-1] if self.cpu_history else 0,
            'ram': self.ram_history[-1] if self.ram_history else 0,
        }
        if self.gpu_history:
            stats['gpu_util'] = self.gpu_history[-1]['util']
            stats['gpu_mem'] = self.gpu_history[-1]['mem_used']
            stats['gpu_mem_total'] = self.gpu_history[-1]['mem_total']
        return stats

