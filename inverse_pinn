# --- 3. MODELO OTIMIZADO PARA GPU ---
class InversePINN(tf.keras.Model):
    def __init__(self):
        super(InversePINN, self).__init__()
        self.dense1 = tf.keras.layers.Dense(48, activation='tanh',
                                            kernel_initializer='glorot_normal',
                                            dtype='float32')
        self.dense2 = tf.keras.layers.Dense(32, activation='tanh',
                                            kernel_initializer='glorot_normal',
                                            dtype='float32')
        self.dense3 = tf.keras.layers.Dense(1, 
                                            bias_initializer=tf.keras.initializers.Constant(319.0),
                                            dtype='float32')
        
        self.log_q_flux = tf.Variable(np.log(4000.0), trainable=True, 
                                      dtype=tf.float32, name='log_q_flux')
    
    @property
    def q_flux(self):
        return tf.exp(self.log_q_flux)
    
    def call(self, y):
        x = self.dense1(y)
        x = self.dense2(x)
        return self.dense3(x)

with tf.device('/GPU:0' if gpus else '/CPU:0'):
    model = InversePINN()

optimizer_network = tf.keras.optimizers.Adam(learning_rate=2e-3)
optimizer_param = tf.keras.optimizers.Adam(learning_rate=8e-2)

# --- 4. LOSS FUNCTION OTIMIZADA PARA GPU ---
@tf.function(reduce_retracing=True, jit_compile=True)  # XLA compilation para GPU
def train_step(model, optimizer_net, optimizer_param, y_train_norm, T_medicoes, y_medicoes_norm, epoch):
    with tf.GradientTape(persistent=True) as tape:
        with tf.GradientTape() as inner_tape:
            inner_tape.watch(y_train_norm)
            T_pred = model(y_train_norm, training=True)
        
        dT_dynorm = inner_tape.gradient(T_pred, y_train_norm)
        dT_dy = dT_dynorm / L_max_tf
        
        y_real = y_train_norm * L_max_tf
        nu_t = nu_tf * ((y_real * v_star_tf) / (14.5 * nu_tf))**3
        
        q_current = model.q_flux
        termo_fonte = q_current / (rho_tf * cp_tf)
        
        residuos = (alpha_tf + nu_t) * dT_dy + termo_fonte
        loss_physics = tf.reduce_mean(tf.square(residuos)) / (termo_fonte**2)
        
        T_pred_medicoes = model(y_medicoes_norm, training=True)
        loss_data = tf.reduce_mean(tf.square(T_pred_medicoes - T_medicoes))
        
        T_0 = model(tf.constant([[0.0]], dtype=tf.float32), training=True)
        loss_bc = tf.square(T_0 - T_parede)
        
        epoch_float = tf.cast(epoch, tf.float32)
        w_data = 100.0
        w_physics = tf.where(epoch < 2000, 0.1, 
                            tf.minimum(0.1 + (epoch_float - 2000.0) / 400.0, 5.0))
        w_bc = 50.0
        
        total_loss = w_data * loss_data + w_physics * loss_physics + w_bc * loss_bc
    
    network_vars = [v for v in model.trainable_variables if 'log_q_flux' not in v.name]
    param_vars = [model.log_q_flux]
    
    grads_network = tape.gradient(total_loss, network_vars)
    grads_param = tape.gradient(total_loss, param_vars)
    
    grads_network, _ = tf.clip_by_global_norm(grads_network, 1.0)
    grads_param, _ = tf.clip_by_global_norm(grads_param, 0.5)
    
    optimizer_net.apply_gradients(zip(grads_network, network_vars))
    optimizer_param.apply_gradients(zip(grads_param, param_vars))
    
    del tape
    return total_loss, loss_data, loss_physics, loss_bc, q_current

